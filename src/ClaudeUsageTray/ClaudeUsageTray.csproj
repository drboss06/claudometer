<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClaudeUsageTray</AssemblyName>
    <RootNamespace>ClaudeUsageTray</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Claude Usage Tray contributors</Authors>
    <Description>Unofficial Windows tray monitor for Claude Code usage limits.</Description>
    <Copyright>Copyright (c) Claude Usage Tray contributors</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Single-file/self-contained options only apply when publishing with
    -p:PublishSingleFile=true (see .github/workflows/release.yml). The runtime
    identifier is supplied on the publish command line so the same project can
    target win-x64 and win-arm64. A plain `dotnet build` stays framework-dependent.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageTray.Tests" />
  </ItemGroup>
</Project>
